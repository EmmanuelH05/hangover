<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Hardened runtime entitlements, used only when the app is signed with a
    Developer ID (scripts/package-app.sh with OPEN_ISLAND_SIGN_IDENTITY).
    An ad-hoc build is signed without the hardened runtime and without this
    file.

    Each key is one of the resource access keys Apple lists for the hardened
    runtime, and each has a matching usage text in the bundle's Info.plist.

    The app is not sandboxed. The App Sandbox network keys
    (com.apple.security.network.client and .server) do nothing outside the
    sandbox and are left out: the weather tile, Notion and the phone relay
    need no entitlement here. Apple lists no key for Reminders. They are
    read through EventKit, like the calendar.

    Audio input is for the lights that follow the music: they read the
    sound the Mac plays through a Core Audio tap, which the hardened runtime
    counts as audio input. The microphone is never opened and the mirror
    records no sound. Its usage text is NSAudioCaptureUsageDescription.

    Not needed: location (the weather city is typed), the Photos library
    (photo strips are plain files), and every runtime exception. The app
    loads only its own frameworks and Apple's.
-->
<plist version="1.0">
<dict>
    <!-- Terminal jumps, replies and the session monitor send Apple events. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!-- The calendar and to-do widgets, through EventKit. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- The mirror and its photo booth. -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>

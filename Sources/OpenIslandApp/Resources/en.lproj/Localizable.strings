/* Tour: the pages only the long tour walks */
"onboarding.more.power.title" = "Notices for the charger and headphones";
"onboarding.more.power.text" = "When the charger goes in or out, or Bluetooth headphones such as AirPods connect, the closed island shows a short notice. No card opens.";
"onboarding.more.power.where" = "Settings, Nook tab, Battery and headphones";
"onboarding.more.volume.title" = "Volume and brightness in the notch";
"onboarding.more.volume.text" = "When the volume changes, the closed island shows the level. You can also let Hangover take the volume and brightness keys, which keeps Apple's popup away.";
"onboarding.more.volume.where" = "Settings, Nook tab, Volume and brightness";
"onboarding.more.volume.note" = "Switching on the keys asks macOS for Accessibility access, and Hangover waits until you allow it. The level notice asks for nothing.";
"onboarding.more.usage.title" = "Your Claude usage at a glance";
"onboarding.more.usage.text" = "When the island is open it can show how much of your Claude 5 hour and 7 day usage you have used, and when each one resets.";
"onboarding.more.usage.where" = "Settings, Setup tab, Claude Usage Bridge";
"onboarding.more.usage.note" = "The meter needs the usage bridge, which tracks usage on your Mac. Set it up in Settings.";
"onboarding.more.quiet.title" = "Quiet while you focus";
"onboarding.more.quiet.text" = "While a focus timer runs, or you are in a meeting with a video link, the pop-up that says an agent finished is not shown. Requests and questions still come through.";
"onboarding.more.quiet.where" = "Settings, Nook tab, Working with the agents";
"onboarding.more.phone.title" = "Answer from your phone or watch";
"onboarding.more.phone.text" = "Hangover can send an agent's request or question to your iPhone and Apple Watch, and take your answer back.";
"onboarding.more.phone.where" = "Settings, Watch tab";
"onboarding.more.phone.note" = "It starts off. It talks to your own devices over your local network, and that traffic is not encrypted.";
"onboarding.more.screens.title" = "Pick the screen it lives on";
"onboarding.more.screens.text" = "Hangover chooses a screen for you. With more than one, you can pin it to the one you want. Each display keeps its own layout.";
"onboarding.more.screens.where" = "Settings, General tab, Monitor";
"onboarding.more.sounds.title" = "Sounds, and one switch to silence them";
"onboarding.more.sounds.text" = "Hangover plays a sound when a timer ends and for other alerts. The Mute switch silences them all.";
"onboarding.more.sounds.where" = "Settings, Sound tab, Mute";
"onboarding.more.links.title" = "Control it from other apps";
"onboarding.more.links.text" = "Shortcuts, Raycast and scripts can open the island, start or stop the timer, and switch the mirror and the ring light, with hangover:// links.";
"onboarding.more.links.where" = "Settings, General tab, Allow links from other apps";
"onboarding.more.links.note" = "It starts on. While it is on, any app on this Mac can send a link.";
"onboarding.more.startup.title" = "Start it with your Mac";
"onboarding.more.startup.text" = "Launch at Login opens Hangover when you sign in, and Show icon in Dock adds it to the Dock. Launch at Login starts off. The icon in the Dock starts on.";
"onboarding.more.startup.where" = "Settings, General tab";
"onboarding.more.updates.title" = "It keeps itself up to date";
"onboarding.more.updates.text" = "About once a day Hangover asks GitHub whether there is a new version. When one is ready, the notch asks before it installs, and it takes a few seconds.";
"onboarding.more.updates.where" = "Settings, About tab";
"onboarding.more.mirror.title" = "Check how you look before a call";
"onboarding.more.mirror.text" = "The mirror shows your camera on the island. Add a frame or stickers, and light your face with the screen like a ring light.";
"onboarding.more.mirror.where" = "Settings, Nook tab, Mirror";
"onboarding.more.mirror.note" = "The camera stays off until you turn the mirror on in its card. macOS asks for the camera the first time you do.";
"onboarding.more.booth.title" = "A photo booth in the mirror";
"onboarding.more.booth.text" = "A countdown, then 4 pictures that come out as a strip. Pick its layout, theme and caption, and each strip is saved in your Pictures folder.";
"onboarding.more.booth.where" = "Settings, Nook tab, Photo booth";
"onboarding.more.weather.title" = "The weather on your island";
"onboarding.more.weather.text" = "See the next hours or the week ahead, and how it feels. Search any city, and the temperature can show on the closed island too.";
"onboarding.more.weather.where" = "Settings, Nook tab, Weather";
"onboarding.more.weather.note" = "The forecast comes from Open-Meteo. Only the city you search for is sent, and nothing is sent while the widget is off.";
"onboarding.more.accent.title" = "Pick the color of your selections";
"onboarding.more.accent.text" = "The accent color is the color of what is picked, checked or switched on: selection rings, ticks and the main buttons. One choice covers every display.";
"onboarding.more.accent.where" = "Settings, Personalization tab, Accent color";
"onboarding.more.switch.mirrorWidget.line" = "Turns the widget on. The camera stays off until you press its button.";
"onboarding.more.switch.weatherWidget.line" = "Turns the widget on. Only the city you search for is sent.";
"onboarding.more.switch.powerNotices" = "Show charger and headphone notices";
"onboarding.more.switch.powerNotices.line" = "A short notice on the closed island. macOS asks for nothing.";
"onboarding.more.switch.volumeNotice.line" = "The closed island shows the level when the volume changes. macOS asks for nothing.";
"onboarding.more.switch.volumeKeys.line" = "Needs Accessibility access. macOS asks when you switch this on, and Hangover waits until you allow it.";
"onboarding.more.switch.usageMeter" = "Show the usage meter when the island is open";
"onboarding.more.switch.usageMeter.line" = "Your Claude 5 hour and 7 day usage, when the island is open. macOS asks for nothing.";
"onboarding.more.switch.focusQuiet" = "Focus timer silences completion pop-ups";
"onboarding.more.switch.focusQuiet.line" = "No pop-up that an agent finished while a focus timer runs. Requests and questions still come through.";
"onboarding.more.switch.meetingQuiet" = "Meetings silence completion pop-ups";
"onboarding.more.switch.meetingQuiet.line" = "No such pop-up during a calendar event with a video link that is on now.";
"onboarding.more.switch.mute.line" = "Silences the timer's end sound and the other alerts. It starts off.";
"onboarding.more.switch.links.line" = "Lets Shortcuts, Raycast and scripts send hangover:// links. It starts on.";
"onboarding.more.switch.launchAtLogin.line" = "Opens Hangover when you sign in. macOS may ask you to approve it in Login Items. It starts off.";
"onboarding.more.switch.dockIcon.line" = "Adds Hangover's icon to the Dock. macOS asks for nothing. It starts on.";
"onboarding.more.switch.autoUpdates.line" = "Downloads a new version and asks before it installs. Off: the island shows Update ready and waits for you.";
